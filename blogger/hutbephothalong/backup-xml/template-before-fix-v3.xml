  </b:if>
</b:includable>
          <b:includable id='nextPageLink'>
  <a class='blog-pager-older-link' expr:href='data:olderPageUrl' expr:id='data:widget.instanceId + &quot;_blog-pager-older-link&quot;' expr:title='data:messages.olderPosts'>
    <data:messages.olderPosts/>
  </a>
</b:includable>
          <b:includable id='nextprev'>
            <div class='blog-pager' style='text-align: center; margin: 30px 0; font-size: 15px;'>
              <b:if cond='data:newerPageUrl'>
                <a class='blog-pager-newer-link' expr:href='data:newerPageUrl' style='margin-right: 20px; padding: 10px 20px; background: #0B6E4F; color: white; border-radius: 6px; text-decoration: none;'>&#8592; Bài mới hơn</a>
              </b:if>
              <b:if cond='data:olderPageUrl'>
                <a class='blog-pager-older-link' expr:href='data:olderPageUrl' style='padding: 10px 20px; background: #0B6E4F; color: white; border-radius: 6px; text-decoration: none;'>Bài cũ hơn &#8594;</a>
              </b:if>
            </div>
          </b:includable>
          <b:includable id='post' var='post'>
            <article class='post-card'>
              <h2 class='post-title'>
                <b:if cond='data:view.isMultipleItems'>
                  <a expr:href='data:post.url'><data:post.title/></a>
                <b:else/>
                  <data:post.title/>
                </b:if>
              </h2>

              <div class='post-meta'>
