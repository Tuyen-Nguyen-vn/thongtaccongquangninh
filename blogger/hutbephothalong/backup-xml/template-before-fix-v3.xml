  {
    &quot;@context&quot;: &quot;https://schema.org&quot;,
    &quot;@type&quot;: &quot;WebSite&quot;,
    &quot;name&quot;: &quot;<data:blog.title/>&quot;,
    &quot;url&quot;: &quot;<data:blog.homepageUrl/>&quot;,
    &quot;publisher&quot;: {
      &quot;@type&quot;: &quot;Organization&quot;,
      &quot;name&quot;: &quot;Môi Trường Đô Thị Số 1 Quảng Ninh&quot;
    }
  }
  </script>
  <script type='application/ld+json'>
  {
    &quot;@context&quot;: &quot;https://schema.org&quot;,
    &quot;@type&quot;: &quot;LocalBusiness&quot;,
    &quot;name&quot;: &quot;Môi Trường Đô Thị Số 1 Quảng Ninh&quot;,
    &quot;telephone&quot;: [&quot;+84963953533&quot;, &quot;+84931156756&quot;],
    &quot;address&quot;: {
      &quot;@type&quot;: &quot;PostalAddress&quot;,
      &quot;addressLocality&quot;: &quot;Hạ Long&quot;,
      &quot;addressRegion&quot;: &quot;Quảng Ninh&quot;,
      &quot;addressCountry&quot;: &quot;VN&quot;
    },
    &quot;areaServed&quot;: [&quot;Quảng Ninh&quot;, &quot;Hải Phòng&quot;],
    &quot;url&quot;: &quot;https://thongtaccongquangninh.com/&quot;,
    &quot;logo&quot;: &quot;https://thongtaccongquangninh.com/wp-content/uploads/2026/05/logo.png&quot;
  }
  </script>

  <!-- Dynamic Breadcrumb Schema cho trang post -->
  <b:if cond='data:view.isPost'>
    <script type='application/ld+json'>
    {
      &quot;@context&quot;: &quot;https://schema.org&quot;,
      &quot;@type&quot;: &quot;BreadcrumbList&quot;,
      &quot;itemListElement&quot;: [
        {
          &quot;@type&quot;: &quot;ListItem&quot;,
          &quot;position&quot;: 1,
          &quot;name&quot;: &quot;Trang chủ&quot;,
          &quot;item&quot;: &quot;<data:blog.homepageUrl/>&quot;
        },
        {
          &quot;@type&quot;: &quot;ListItem&quot;,
          &quot;position&quot;: 2,
          &quot;name&quot;: &quot;Kiến thức&quot;,
          &quot;item&quot;: &quot;<data:blog.homepageUrl/>search/label/kien-thuc-be-phot&quot;
        },
        {
          &quot;@type&quot;: &quot;ListItem&quot;,
          &quot;position&quot;: 3,
          &quot;name&quot;: &quot;<data:view.title.escaped/>&quot;,
          &quot;item&quot;: &quot;<data:blog.url.canonical/>&quot;
        }
      ]
    }
    </script>
  </b:if>

  <b:skin><![CDATA[
  /*
   * Theme: Blogger Vệ Tinh Chuẩn SEO - Xanh Môi Trường
   * Designed for: Môi Trường Đô Thị Số 1 Quảng Ninh (thongtaccongquangninh.com)
   * Designed by: Antigravity
   */
  
  /* CSS Variables - Design Tokens */
  :root {
    --color-primary: #0B6E4F;      /* Xanh môi trường đậm, gợi sạch sẽ */
    --color-secondary: #F4A300;    /* Cam cảnh báo dùng cho CTA hotline */
    --color-primary-dark: #074b35;
    --color-bg-body: #ffffff;
    --color-bg-section: #f7f7f5;   /* Xám nhẹ tinh tế */
    --color-text-body: #1a1a1a;
    --color-text-meta: #5a5a5a;
    --font-family: 'Be Vietnam Pro', sans-serif;
  }
  
  /* Reset CSS */
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body {
    font-family: var(--font-family);
    background-color: var(--color-bg-section);
    color: var(--color-text-body);
    line-height: 1.7;
    font-size: 17px;
  }
  a { color: var(--color-primary); text-decoration: none; transition: all 0.3s ease; }
  a:hover { color: var(--color-primary-dark); text-decoration: underline; }
  img { max-width: 100%; height: auto; display: block; border-radius: 8px; }
  
  /* Layout Containers */
  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }
  
  /* Header Sticky */
  header {
    background: var(--color-primary);
    color: white;
    padding: 15px 0;
    box-shadow: 0 4px 10px rgba(0,0,0,0.08);
    position: sticky;
    top: 0;
    z-index: 100;
  }
  .header-wrapper {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .logo h1 {
    font-size: 22px;
    font-weight: 800;
    letter-spacing: -0.5px;
  }
  .logo h1 a {
    color: white;
  }
  .logo h1 a:hover {
    text-decoration: none;
  }
  
  /* Hotline Pulse Button màu Cam */
  .header-hotline {
    background: var(--color-secondary);
    padding: 10px 20px;
    border-radius: 50px;
    font-weight: 700;
    font-size: 16px;
    box-shadow: 0 4px 15px rgba(244, 163, 0, 0.4);
    animation: pulse 1.5s infinite;
  }
  .header-hotline a {
    color: white;
  }
  @keyframes pulse {
    0% { transform: scale(1); }
    50% { transform: scale(1.04); }
    100% { transform: scale(1); }
  }
  
  /* Main Content Area */
  .main-wrapper {
    display: grid;
    grid-template-columns: 2.1fr 1fr;
    gap: 35px;
    margin: 40px auto;
  }
  
  /* Post Area */
  .post-card {
    background: white;
    padding: 35px;
    border-radius: 12px;
    box-shadow: 0 4px 15px rgba(0,0,0,0.03);
    margin-bottom: 30px;
  }
  .post-title {
    font-size: 28px;
    font-weight: 700;
    color: var(--color-primary);
    margin-bottom: 15px;
    line-height: 1.35;
  }
  .post-title a {
    color: var(--color-primary);
  }
  .post-title a:hover {
    color: var(--color-primary-dark);
    text-decoration: none;
  }
  .post-meta {
    font-size: 14px;
    color: var(--color-text-meta);
    margin-bottom: 25px;
    border-bottom: 1px solid #f0f0ee;
    padding-bottom: 10px;
  }
  .post-body {
    font-size: 17px;
    color: var(--color-text-body);
    text-align: justify;
  }
  
  /* Styling On-page HTML cho Bài viết */
  .post-body h2 {
    font-size: 22px;
    color: var(--color-primary);
    margin: 35px 0 15px 0;
    border-left: 5px solid var(--color-secondary);
    padding-left: 15px;
    font-weight: 700;
  }
  .post-body h3 {
    font-size: 19px;
    color: var(--color-primary);
    margin: 25px 0 12px 0;
    font-weight: 600;
  }
  .post-body p {
    margin-bottom: 18px;
  }
  .post-body ul, .post-body ol {
    margin-bottom: 22px;
    padding-left: 20px;
  }
  .post-body li {
    margin-bottom: 10px;
  }
  .post-body strong {
    font-weight: 600;
    color: #000000;
  }
  
  /* Table styling chuẩn */
  .post-body table {
    width: 100%;
    border-collapse: collapse;
    margin: 25px 0;
    font-size: 15px;
  }
  .post-body table th {
    background-color: var(--color-primary);
    color: white;
    font-weight: bold;
    padding: 12px;
    border: 1px solid #e5e7eb;
  }
  .post-body table td {
    padding: 12px;
    border: 1px solid #e5e7eb;
  }
  .post-body table tr:nth-child(even) {
    background-color: #fafafa;
  }

  /* Sidebar */
  aside {
    display: flex;
    flex-direction: column;
    gap: 30px;
  }
  .widget-box {
    background: white;
    padding: 25px;
    border-radius: 12px;
    box-shadow: 0 4px 15px rgba(0,0,0,0.03);
  }
  .widget-title {
    font-size: 18px;
    font-weight: 700;
    color: var(--color-primary);
    border-bottom: 2px solid #f0f0ee;
    padding-bottom: 12px;
    margin-bottom: 15px;
  }
  
  /* Widget NAP giống site mẹ */
  .nap-box {
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
    color: white;
    padding: 30px;
    border-radius: 12px;
    box-shadow: 0 4px 15px rgba(11, 110, 79, 0.2);
  }
  .nap-box h3 {
    font-size: 18px;
    font-weight: 800;
    margin-bottom: 15px;
    border-bottom: 1px solid rgba(255,255,255,0.15);
    padding-bottom: 10px;
    letter-spacing: 0.5px;
  }
  .nap-box p {
    font-size: 14px;
    margin-bottom: 12px;
    line-height: 1.6;
    color: #e2f0ea;
  }
  .nap-btn {
    display: block;
    background: var(--color-secondary);
    color: white !important;
    text-align: center;
    padding: 12px;
    border-radius: 8px;
    font-weight: 700;
    margin-top: 15px;
    box-shadow: 0 4px 10px rgba(244, 163, 0, 0.3);
    text-decoration: none !important;
  }
  
  /* Footer */
  footer {
    background: #111e18;
    color: #92a39a;
    padding: 40px 0;
    text-align: center;
    font-size: 14px;
    border-top: 5px solid var(--color-primary);
  }
  footer p {
    margin-bottom: 10px;
  }
  footer a {
    color: white;
    font-weight: 600;
  }
  
  /* Responsive */
  @media (max-width: 768px) {
    .main-wrapper {
      grid-template-columns: 1fr;
      margin: 20px auto;
    }
    .header-wrapper {
      flex-direction: column;
      gap: 15px;
      text-align: center;
    }
    .post-card {
      padding: 20px;
    }
    .post-title {
      font-size: 22px;
    }
  }
  ]]></b:skin>
</head>

<body>
  <!-- Header Section -->
  <header>
    <div class='container header-wrapper'>
      <div class='logo'>
        <h1><a expr:href='data:blog.homepageUrl'>HÚT BỂ PHỐT HẠ LONG</a></h1>
      </div>
      <div class='header-hotline'>
        <a href='tel:0963953533'>HOTLINE: 0963.953.533</a>
      </div>
    </div>
  </header>

  <!-- Main Section -->
  <div class='container main-wrapper'>
    
    <!-- Blog Post Area -->
    <main>
      <b:section id='main' showaddelement='false'>
        <b:widget id='Blog1' locked='true' title='Bài đăng trên Blog' type='Blog' version='2' visible='true'>
          <b:widget-settings>
            <b:widget-setting name='showDateHeader'>false</b:widget-setting>
            <b:widget-setting name='style.textcolor'>#ffffff</b:widget-setting>
            <b:widget-setting name='showShareButtons'>false</b:widget-setting>
            <b:widget-setting name='showCommentLink'>false</b:widget-setting>
            <b:widget-setting name='style.urlcolor'>#ffffff</b:widget-setting>
            <b:widget-setting name='showAuthor'>false</b:widget-setting>
            <b:widget-setting name='style.linkcolor'>#ffffff</b:widget-setting>
            <b:widget-setting name='style.unittype'>TextAndImage</b:widget-setting>
            <b:widget-setting name='style.bgcolor'>#ffffff</b:widget-setting>
            <b:widget-setting name='timestampLabel'/>
            <b:widget-setting name='reactionsLabel'/>
            <b:widget-setting name='showAuthorProfile'>false</b:widget-setting>
            <b:widget-setting name='style.layout'>1x1</b:widget-setting>
            <b:widget-setting name='showLabels'>true</b:widget-setting>
            <b:widget-setting name='showLocation'>false</b:widget-setting>
            <b:widget-setting name='postLabelsLabel'/>
            <b:widget-setting name='showTimestamp'>true</b:widget-setting>
            <b:widget-setting name='postsPerAd'>1</b:widget-setting>
            <b:widget-setting name='showBacklinks'>false</b:widget-setting>
            <b:widget-setting name='style.bordercolor'>#ffffff</b:widget-setting>
            <b:widget-setting name='showInlineAds'>false</b:widget-setting>
            <b:widget-setting name='showReactions'>false</b:widget-setting>
          </b:widget-settings>
          <b:includable id='main'>
            <b:loop values='data:posts' var='post'>
              <b:include data='post' name='post'/>
            </b:loop>
            <b:include name='nextprev'/>
          </b:includable>
          <b:includable id='aboutPostAuthor'>
  <div class='author-name'>
    <a class='g-profile' expr:href='data:post.author.profileUrl' rel='author' title='author profile'>
      <span>
        <data:post.author.name/>
      </span>
    </a>
  </div>
  <div>
    <span class='author-desc'>
      <data:post.author.aboutMe/>
    </span>
  </div>
</b:includable>
          <b:includable id='addComments'>
          </b:includable>
          <b:includable id='commentAuthorAvatar'>
  <div class='avatar-image-container'>
    <img class='author-avatar' expr:src='data:comment.authorAvatarSrc' height='35' width='35'/>
  </div>
</b:includable>
          <b:includable id='commentDeleteIcon' var='comment'>
  <span expr:class='&quot;item-control &quot; + data:comment.adminClass'>
    <b:if cond='data:showCmtPopup'>
      <div class='goog-toggle-button'>
        <div class='goog-inline-block comment-action-icon'/>
      </div>
    <b:else/>
      <a class='comment-delete' expr:href='data:comment.deleteUrl' expr:title='data:messages.deleteComment'>
        <img src='https://resources.blogblog.com/img/icon_delete13.gif'/>
      </a>
    </b:if>
  </span>
</b:includable>
          <b:includable id='commentForm' var='post'>
          </b:includable>
          <b:includable id='commentFormIframeSrc' var='post'>
  <a expr:href='data:post.commentFormIframeSrc' id='comment-editor-src'/>
</b:includable>
          <b:includable id='commentItem' var='comment'>
  <div class='comment' expr:id='&quot;c&quot; + data:comment.id'>
    <b:include cond='data:blog.enabledCommentProfileImages' name='commentAuthorAvatar'/>

    <div class='comment-block'>
      <div class='comment-author'>
        <b:if cond='data:comment.authorUrl'>
          <b:message name='messages.authorSaidWithLink'>
            <b:param expr:value='data:comment.author' name='authorName'/>
            <b:param expr:value='data:comment.authorUrl' name='authorUrl'/>
          </b:message>
        <b:else/>
          <b:message name='messages.authorSaid'>
            <b:param expr:value='data:comment.author' name='authorName'/>
          </b:message>
        </b:if>
      </div>
      <div expr:class='&quot;comment-body&quot; + (data:comment.isDeleted ? &quot; deleted&quot; : &quot;&quot;)'>
        <data:comment.body/>
      </div>
      <div class='comment-footer'>
        <span class='comment-timestamp'>
          <a expr:href='data:comment.url' title='comment permalink'>
            <data:comment.timestamp/>
          </a>
          <b:include data='comment' name='commentDeleteIcon'/>
        </span>
      </div>
    </div>
  </div>
</b:includable>
          <b:includable id='commentList' var='comments'>
  <div id='comments-block'>
    <b:loop values='data:comments' var='comment'>
      <b:include data='comment' name='commentItem'/>
    </b:loop>
  </div>
</b:includable>
          <b:includable id='commentPicker' var='post'>
  <b:if cond='data:post.showThreadedComments'>
    <b:include data='post' name='threadedComments'/>
  <b:else/>
    <b:include data='post' name='comments'/>
  </b:if>
</b:includable>
          <b:includable id='comments' var='post'>
          </b:includable>
          <b:includable id='commentsTitle'>
  <h3 class='title'><data:messages.comments/></h3>
</b:includable>
          <b:includable id='feedLinks'>
          </b:includable>
          <b:includable id='feedLinksBody'>
          </b:includable>
          <b:includable id='footerByline' var='post'>
          </b:includable>
          <b:includable id='headerByline' var='post'>
          </b:includable>
          <b:includable id='homePageLink'>
  <a class='home-link' expr:href='data:blog.homepageUrl'>
    <data:messages.home/>
  </a>
</b:includable>
          <b:includable id='iframeComments' var='post'>
  <!-- G+ comments, no longer available. The includable is retained for backwards-compatibility. -->
</b:includable>
          <b:includable id='inlineAd' var='post'>
  <b:if cond='!data:view.isPreview'>
